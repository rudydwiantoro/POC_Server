<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvUserInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User: -"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spChannel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Connect Signaling" />

    <Button
        android:id="@+id/btnPtt"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="Hold To Talk"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvMiniDisplayLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mini Display (1 baris)"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvMiniDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="8dp"
        android:text="-"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etShortMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:enabled="false"
        android:hint="Ketik short message (max 160)"
        android:inputType="textCapSentences"
        android:maxLength="160"
        android:maxLines="1" />

    <Button
        android:id="@+id/btnSendShortMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="Send Short Message" />

    <TextView
        android:id="@+id/tvFloorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Floor: -"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvSignalStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Signal: disconnected"
        android:textSize="14sp" />
</LinearLayout>
